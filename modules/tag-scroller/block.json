{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "dhsv/tag-scroller",
  "title": "Tag Scroller",
  "description": "Tag Scroller",
  "icon": "tag",
  "category": "text",
  "usesContext": [],
  "keywords": [],
  "textdomain": "dhsv_theme",
  "attributes": {
    "align": {
      "type": "string",
      "default": "none"
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "tags": {
      "type": "array",
      "default": []
    },
    "categories": {
      "type": "array",
      "default": []
    },
    "maxItems": {
      "type": "number",
      "default": 20
    },
    "direction": {
      "type": "string",
      "default": "left-to-right"
    }
  },
  "supports": {
    "align": ["full", "wide"]
  },
  "styles": [],
  "example": {
    "attributes": {
      "tags": ["Tag 1", "Tag 2", "Tag 3"]
    }
  }
}
