{#- Übersetzt aus source/index.blade.php (Theme dhsv012). Reine Attribut-Ausgabe, keine WP-Lookups.
    Kein get_block_wrapper_attributes im Original – daher kein wrapper(). -#}
<div class="dhsv-animated-number-block align{{ align }}" data-animation-duration="{{ animationDuration }}">
    <div class="dhsv-animated-number-block__content">
        <div
            class="dhsv-animated-number-block__number"
            data-number="{{ number }}"
            data-suffix="{{ suffix }}"
            data-thousands-separator-mode="{{ thousandsSeparatorMode or 'auto' }}"
            style="color: {{ numberColor }}"
        >
            {{ number }}{{ suffix }}
        </div>
        <div
            class="dhsv-animated-number-block__text"
            style="color: {{ textColor }}"
        >
            {{ text | safe }}
        </div>
    </div>
</div>
