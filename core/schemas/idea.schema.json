{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Playground-Idee",
  "type": "object",
  "required": ["slug", "title", "summary", "type", "status", "author", "contributors", "created", "updated", "tags", "pages", "baseline", "theme", "history"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3 },
    "summary": { "type": "string" },
    "type": { "type": "string" },
    "status": { "type": "string" },
    "author": { "type": "string", "minLength": 1 },
    "contributors": { "type": "array", "items": { "type": "string" } },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "pages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "basedOn": { "type": "string" },
          "bodyClass": { "type": "string" }
        }
      }
    },
    "baseline": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
    "themeSha": { "type": ["string", "null"] },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticket": { "type": ["string", "null"] },
        "pr": { "type": ["string", "null"] }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "user"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string" },
          "user": { "type": "string" },
          "status": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
